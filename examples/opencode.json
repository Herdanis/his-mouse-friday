{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "hmf": {
      "type": "local",
      "command": ["hmf-mcp"],
      "enabled": true,
      "timeout": 330000
    }
  },
  "permission": {
    "bash": {
      "kubectl delete": "deny",
      "kubectl apply": "deny",
      "gcloud * delete": "deny",
      "aws * delete": "deny",
      "kubectl scale": "ask",
      "*": "ask"
    }
  }
}
